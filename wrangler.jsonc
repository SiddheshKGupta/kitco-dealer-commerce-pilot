{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kitco-dealer-commerce",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-13",
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "partners.kitco.co.in", "custom_domain": true }
  ],
  "vars": {
    "OTP_FROM_EMAIL": "KITCO <onboarding@resend.dev>"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "CATALOGUE_MEDIA",
      "bucket_name": "kitco-dealer-commerce-private-media"
    }
  ]
}
